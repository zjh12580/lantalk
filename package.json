{
  "name": "lantalk",
  "version": "1.0.0",
  "private": true,
  "description": "LanTalk 云聊 · 云端版（邮箱登录 + 云端 Postgres/对象存储 + 小美 AI 智能体）",
  "scripts": {
    "start": "node cloud/server.js",
    "test": "node cloud/test-load.js && node cloud/test-intent.js",
    "test:load": "node cloud/test-load.js",
    "test:intent": "node cloud/test-intent.js",
    "test:qa": "node cloud/qa-probe-unit.js && node cloud/qa-probe-dom.js && node cloud/qa-probe-server.js",
    "test:qa:unit": "node cloud/qa-probe-unit.js",
    "test:qa:dom": "node cloud/qa-probe-dom.js",
    "test:qa:server": "node cloud/qa-probe-server.js",
    "lint": "eslint cloud/server.js cloud/agent.js scripts/*.mjs && node scripts/lint-html.mjs",
    "lint:js": "eslint cloud/server.js cloud/agent.js scripts/*.mjs",
    "lint:html": "node scripts/lint-html.mjs",
    "stamp": "node scripts/stamp-version.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^22.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
